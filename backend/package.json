{
  "name": "vacunacion-hmgu-backend",
  "version": "1.0.0",
  "description": "API REST del Sistema Web Móvil para el Control y Seguimiento del Esquema de Vacunación Inteligente de Pacientes - Hospital Materno Germán Urquidi",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/database/runMigrations.js",
    "seed": "node src/database/runMigrations.js --seed",
    "backup": "node -e \"require('./src/services/backup.service').runBackup().then(()=>process.exit(0))\""
  },
  "keywords": [
    "vacunacion",
    "hospital",
    "pai-bolivia",
    "express",
    "mysql"
  ],
  "author": "Hospital Materno German Urquidi",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
