# Copiar estos valores a .env y completar localmente.
# Nunca subir .env a Git. Usar contraseña de aplicación, no la contraseña de Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Activar solo después de configurar y validar el remitente.
SMTP_ENABLED=false
