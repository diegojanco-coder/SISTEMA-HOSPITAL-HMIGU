# Entorno
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
TZ=America/La_Paz
# npm start desde la raíz habilita interfaz y API en un único servidor.
SERVE_FRONTEND=false

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vacunacion_hmgu
DB_CONNECTION_LIMIT=10

# JWT
JWT_SECRET=REEMPLAZAR_CON_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=8h
SECRET_KEY=REEMPLAZAR_CON_UN_SECRETO_HMAC_DIFERENTE_Y_ALEATORIO
AUTH_COOKIE_NAME=hmgu_session
AUTH_COOKIE_MAX_AGE_MS=28800000
# En producción HTTPS debe permanecer true. En desarrollo HTTP use false.
COOKIE_SECURE=false

# CORS - URL del frontend
FRONTEND_URL=http://localhost:5173
# Lista explícita separada por comas si existen varios frontends autorizados.
FRONTEND_ORIGINS=http://localhost:5173

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Respaldo automático (cron: todos los días a las 02:00 am)
BACKUP_CRON=0 2 * * *
BACKUP_DIR=./backups

# Alertas automáticas (cron: todos los días a las 06:00 am)
ALERTAS_CRON=0 6 * * *

# WhatsApp: sin API key funciona en modo MOCK y solo registra el payload.
# Proveedores: meta | twilio. Para Twilio: API_KEY=ACCOUNT_SID:AUTH_TOKEN.
WHATSAPP_PROVIDER=meta
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Herramienta de respaldo (debe existir en el PATH del servidor)
# Windows: puede indicar la ruta completa a mysqldump.exe.
MYSQLDUMP_PATH=
# Cliente para la prueba aislada de restauración (mysql.exe en Windows).
MYSQL_PATH=

# Gmail: completar localmente; nunca subir contraseñas a Git.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
