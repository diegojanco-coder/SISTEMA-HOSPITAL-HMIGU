# Entorno
NODE_ENV=development
PORT=4000

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vacunacion_hmgu
DB_CONNECTION_LIMIT=10

# JWT
JWT_SECRET=REEMPLAZAR_CON_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=8h

# CORS - URL del frontend
FRONTEND_URL=http://localhost:5173

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Respaldo automático (cron: todos los días a las 02:00 am)
BACKUP_CRON=0 2 * * *
BACKUP_DIR=./backups

# Alertas automáticas (cron: todos los días a las 06:00 am)
ALERTAS_CRON=0 6 * * *

# Herramienta de respaldo (debe existir en el PATH del servidor)
MYSQLDUMP_PATH=mysqldump

# SMTP de producción para notificaciones reales (no incluir credenciales en Git)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificaciones@example.com
SMTP_PASS=REEMPLAZAR_CON_PASSWORD_SMTP
SMTP_FROM=Hospital Materno Germán Urquidi <notificaciones@example.com>
