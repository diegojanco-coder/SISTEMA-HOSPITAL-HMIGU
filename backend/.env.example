# Entorno
NODE_ENV=development
PORT=4000

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=liam123
DB_NAME=vacunacion_hmgu
DB_CONNECTION_LIMIT=10

# JWT
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# CORS - URL del frontend
FRONTEND_URL=http://localhost:5173

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Respaldo automático (cron: todos los días a las 02:00 am)
BACKUP_CRON=0 2 * * *
BACKUP_DIR=./backups

# Alertas automáticas (cron: todos los días a las 06:00 am)
ALERTAS_CRON=0 6 * * *

# Herramienta de respaldo (debe existir en el PATH del servidor)
MYSQLDUMP_PATH=mysqldump
